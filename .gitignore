# Node.js / pnpm local dependency trees and build output
**/node_modules/
**/dist/
**/coverage/
**/.pnpm-store/
**/.turbo/
apps/api/src/generated/prisma/

# Local environment and secrets — permit templates
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/.env.keys

# Supabase CLI machine-local state
supabase/.temp/
supabase/.branches/

# Keep most local project documentation private; allow Superpowers specs/plans in Git.
/docs/*
!/docs/superpowers/
/scripts/
# Track the safe database-test helper; keep other developer scratch scripts ignored.
!/scripts/
/scripts/*
!/scripts/db-test.ps1

# Local scratch and OS noise
.superpowers/
.temp/
.DS_Store
Thumbs.db

# Local Python helper caches (Tencent DEV scripts)
**/__pycache__/
**/*.py[cod]

# Local sensitive media reference previews; never ship via public/ or dist/
apps/web/.local-private/
